# Go build output (sc-capture/ is part of this repository)
sc-capture/out/
*.exe
*.test
*.out

# Captured traffic NEVER goes in git. Recordings contain login credentials in
# the clear — the master-server protocol has no transport encryption.
captures/
SC_*__*/
*.pcapng
*.pcap

# Submitted bundles land here but are not tracked, for the same reason.
packet-caps/*
!packet-caps/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Env
.env
.env.*
